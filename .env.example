NODE_ENV=development
API_PORT=4000
MONGODB_URI=mongodb://localhost:27017/circular-city?replicaSet=rs0
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-development-secret-of-at-least-32-characters
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
DNS_SERVERS=8.8.8.8,8.8.4.4
CHATBOT_PROVIDER=disabled
# Required only when running `pnpm seed` outside production.
SEED_FACILITATOR_PASSWORD=replace-with-a-local-development-password
